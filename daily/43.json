{
 "grammar": {
  "theme": "Expressing purpose",
  "items": [
   {
    "s": "to + V",
    "uz": "maqsad (eng oddiy)",
    "ex": "I study every day to improve my score.",
    "use": "Asosiy"
   },
   {
    "s": "in order to / so as to + V",
    "uz": "rasmiyroq maqsad",
    "ex": "Governments tax fuel in order to reduce pollution.",
    "use": "Task 2"
   },
   {
    "s": "in order not to / so as not to",
    "uz": "inkor maqsad",
    "ex": "I left early so as not to miss the bus.",
    "use": "❌ to not"
   },
   {
    "s": "so that + can/could/will/would",
    "uz": "maqsad (ega o'zgarsa)",
    "ex": "Cities build parks so that people can relax.",
    "use": "Murakkab gap"
   },
   {
    "s": "for + noun / -ing (function)",
    "uz": "vazifa bildiradi",
    "ex": "This app is for learning vocabulary.",
    "use": "Narsalar vazifasi"
   },
   {
    "s": "with the aim of + -ing",
    "uz": "… maqsadida",
    "ex": "The law was passed with the aim of protecting children.",
    "use": "Band 7"
   },
   {
    "s": "in an attempt to + V",
    "uz": "… ga urinib",
    "ex": "Prices were cut in an attempt to boost sales.",
    "use": "Task 1/2"
   },
   {
    "s": "❌ I came here for study → ✅ I came here to study",
    "uz": "maqsad uchun to + V",
    "ex": "I went to the library to study.",
    "use": "O'zbekchadan ko'chirma xato"
   }
  ]
 },
