 "task1": {
  "theme": "Writing about a process with no numbers",
  "items": [
   {
    "w": "There are X main stages",
    "syn": "the process consists of",
    "uz": "X ta asosiy bosqich bor",
    "ex": "There are six main stages in the process."
   },
   {
    "w": "from … to …",
    "syn": "beginning to end",
    "uz": "… dan … gacha",
    "ex": "…from the collection of milk to delivery."
   },
   {
    "w": "Overview: start, end, number of stages",
    "syn": "summary",
    "uz": "overview: boshlanish, oxir, bosqichlar soni",
    "ex": "Overall, it is a linear process with five stages."
   },
   {
    "w": "linear vs cyclical",
    "syn": "one-way vs repeating",
    "uz": "chiziqli vs aylanma",
    "ex": "The water cycle is cyclical."
   },
   {
    "w": "natural vs man-made",
    "syn": "type of process",
    "uz": "tabiiy vs sun'iy",
    "ex": "This is a man-made process."
   },
   {
    "w": "use present simple passive",
    "syn": "is collected",
    "uz": "hozirgi zamon passiv",
    "ex": "The milk is collected from farms."
   },
   {
    "w": "describe every stage",
    "syn": "complete",
    "uz": "har bir bosqichni yozing",
    "ex": "Missing stages lower Task Achievement."
   },
   {
    "w": "add detail from labels",
    "syn": "use diagram words",
    "uz": "diagrammadagi so'zlardan foydalaning",
    "ex": "…at a temperature of 72°C."
   },
   {
    "w": "two body paragraphs",
    "syn": "split stages",
    "uz": "bosqichlarni ikkiga bo'ling",
    "ex": "Stages 1–3 and stages 4–6."
   },
   {
    "w": "avoid 'firstly, secondly, thirdly' only",
    "syn": "vary sequencers",
    "uz": "faqat firstly/secondly emas",
    "ex": "Use once, next, after that."
   }
  ]
 },
