{
 "grammar": {
  "theme": "Advanced concession: while, albeit, even if, much as",
  "items": [
   {
    "s": "While + clause, main clause",
    "uz": "garchi … bo'lsa-da",
    "ex": "While I agree in part, I think the cost is too high.",
    "use": "Task 2 muvozanat"
   },
   {
    "s": "albeit + adj/adverb",
    "uz": "garchi (rasmiy, qisqa)",
    "ex": "Sales rose, albeit slowly.",
    "use": "Band 8 so'z"
   },
   {
    "s": "even if + clause",
    "uz": "hatto … bo'lsa ham",
    "ex": "Even if prices fall, people won't buy cars.",
    "use": "Shartli kontrast"
   },
   {
    "s": "even though + clause",
    "uz": "garchi … bo'lsa ham (fakt)",
    "ex": "Even though it rained, we went out.",
    "use": "Fakt"
   },
   {
    "s": "much as + clause",
    "uz": "qanchalik … bo'lmasin",
    "ex": "Much as I love the city, it's too crowded.",
    "use": "Speaking band 8"
   },
   {
    "s": "regardless of + noun",
    "uz": "… dan qat'i nazar",
    "ex": "Education should be free regardless of income.",
    "use": "Task 2"
   },
   {
    "s": "admittedly, …",
    "uz": "tan olish kerakki",
    "ex": "Admittedly, this solution is expensive.",
    "use": "Task 2 qarama-qarshi fikr"
   },
   {
    "s": "❌ Even I tried, I failed → ✅ Even though I tried, I failed",
    "uz": "even yolg'iz bog'lovchi emas",
    "ex": "Even though I studied, I was nervous.",
    "use": "Tipik xato"
   }
  ]
 },
