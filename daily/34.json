{
 "grammar": {
  "theme": "Noun clauses",
  "items": [
   {
    "s": "that-clause as object",
    "uz": "fe'ldan keyin to'liq fikr",
    "ex": "Many people believe that exams are unfair.",
    "use": "Task 2"
   },
   {
    "s": "It is + adj + that …",
    "uz": "rasmiy baho",
    "ex": "It is clear that action is needed.",
    "use": "Akademik uslub"
   },
   {
    "s": "The fact that …",
    "uz": "… ekanligi",
    "ex": "The fact that prices rose surprised no one.",
    "use": "Band 7 ega"
   },
   {
    "s": "what-clause as subject",
    "uz": "… qilgan narsa",
    "ex": "What surprised me was the cost.",
    "use": "Cleft bilan bog'liq"
   },
   {
    "s": "whether / if-clause",
    "uz": "…mi yoki yo'qmi",
    "ex": "It is unclear whether the plan will work.",
    "use": "Ehtiyotkor fikr"
   },
   {
    "s": "wh-clause as object",
    "uz": "nima/qanday … ekanligi",
    "ex": "I don't know why he left.",
    "use": "Speaking"
   },
   {
    "s": "How + adj + clause",
    "uz": "qanchalik … ekanligi",
    "ex": "It shows how important sleep is.",
    "use": "Task 2"
   },
   {
    "s": "❌ I don't know what is his name → ✅ what his name is",
    "uz": "noun clause'da oddiy tartib",
    "ex": "Nobody knows where the money went.",
    "use": "Tipik xato"
   }
  ]
 },
