{
 "grammar": {
  "theme": "Advanced comparison structures",
  "items": [
   {
    "s": "the + comparative, the + comparative",
    "uz": "qancha … shuncha …",
    "ex": "The more you practise, the better you get.",
    "use": "Band 7+ struktura"
   },
   {
    "s": "as … as / not as … as",
    "uz": "teng / teng emas",
    "ex": "Buses are not as fast as the metro.",
    "use": "Taqqoslash"
   },
   {
    "s": "not nearly as … as",
    "uz": "unchalik ham … emas",
    "ex": "Rent here is not nearly as high as in London.",
    "use": "Kuchli farq"
   },
   {
    "s": "nowhere near as … as",
    "uz": "aslo … emas",
    "ex": "My Writing is nowhere near as good as my Reading.",
    "use": "Speaking"
   },
   {
    "s": "comparative + and + comparative",
    "uz": "tobora …",
    "ex": "Cities are getting bigger and bigger.",
    "use": "O'zgarish"
   },
   {
    "s": "the same + noun + as",
    "uz": "xuddi … kabi",
    "ex": "She has the same job as her mother.",
    "use": "O'xshashlik"
   },
   {
    "s": "much / a lot / far + comparative",
    "uz": "ancha …roq",
    "ex": "It's far cheaper to cook at home.",
    "use": "Kuchaytirish"
   },
   {
    "s": "❌ The more I study, I get better → ✅ the better I get",
    "uz": "ikkinchi qism ham 'the + comparative'",
    "ex": "The earlier you start, the easier it is.",
    "use": "Tipik xato"
   }
  ]
 },
