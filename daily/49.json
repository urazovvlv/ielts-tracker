{
 "grammar": {
  "theme": "Run-on sentences and fragments",
  "items": [
   {
    "s": "Run-on: two sentences joined by a comma",
    "uz": "ikki to'liq gap vergul bilan — xato",
    "ex": "❌ Prices rose, people bought less.",
    "use": "Comma splice"
   },
   {
    "s": "Fix 1: full stop",
    "uz": "nuqta qo'ying",
    "ex": "Prices rose. People bought less.",
    "use": "Oddiy yechim"
   },
   {
    "s": "Fix 2: conjunction",
    "uz": "bog'lovchi qo'shing",
    "ex": "Prices rose, so people bought less.",
    "use": "Compound"
   },
   {
    "s": "Fix 3: subordinate clause",
    "uz": "ergash gap",
    "ex": "Because prices rose, people bought less.",
    "use": "Complex — band 7"
   },
   {
    "s": "Fix 4: semicolon + linker",
    "uz": "nuqtali vergul",
    "ex": "Prices rose; as a result, people bought less.",
    "use": "Band 7+"
   },
   {
    "s": "Fragment: no main verb",
    "uz": "fe'lsiz gap — xato",
    "ex": "❌ For example, the high cost of living.",
    "use": "Fragment"
   },
   {
    "s": "Fragment fix",
    "uz": "to'liq gap qiling",
    "ex": "For example, the cost of living is high.",
    "use": "Tuzatish"
   },
   {
    "s": "❌ However prices rose → ✅ However, prices rose.",
    "uz": "however — yangi gap + vergul",
    "ex": "However, prices rose.",
    "use": "Tipik xato"
   }
  ]
 },
