{
 "grammar": {
  "theme": "Emphasis: do/does/did, so and such",
  "items": [
   {
    "s": "do/does/did + V for emphasis",
    "uz": "tasdiqni kuchaytirish",
    "ex": "I do understand your point.",
    "use": "Speaking emfaza"
   },
   {
    "s": "so + adjective / adverb",
    "uz": "shunchalik …",
    "ex": "The exam was so difficult.",
    "use": "Hissiyot"
   },
   {
    "s": "such + (a) + adjective + noun",
    "uz": "shunday … ki",
    "ex": "It was such a long day.",
    "use": "❌ so long day"
   },
   {
    "s": "so … that …",
    "uz": "shunchalik …ki …",
    "ex": "It was so hot that we stayed inside.",
    "use": "Natija"
   },
   {
    "s": "such … that …",
    "uz": "shunday … ki …",
    "ex": "It was such a good film that I watched it twice.",
    "use": "Natija"
   },
   {
    "s": "so much / so many",
    "uz": "shuncha ko'p",
    "ex": "There were so many people.",
    "use": "Miqdor"
   },
   {
    "s": "the very + noun",
    "uz": "aynan o'sha",
    "ex": "That was the very moment I decided.",
    "use": "Band 8"
   },
   {
    "s": "❌ It was so a good day → ✅ It was such a good day",
    "uz": "otdan oldin such",
    "ex": "It was such a beautiful view.",
    "use": "Tipik xato"
   }
  ]
 },
