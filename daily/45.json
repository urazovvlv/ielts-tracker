{
 "grammar": {
  "theme": "Future in the past",
  "items": [
   {
    "s": "was/were going to + V",
    "uz": "o'tmishdagi reja (amalga oshmagan)",
    "ex": "I was going to call you, but I forgot.",
    "use": "Hikoya"
   },
   {
    "s": "would + V (future in the past)",
    "uz": "o'tmishdan kelajakka qarash",
    "ex": "I knew it would be difficult.",
    "use": "Part 2"
   },
   {
    "s": "was about to + V",
    "uz": "endi … moqchi edi",
    "ex": "I was about to leave when he arrived.",
    "use": "Hikoya"
   },
   {
    "s": "was supposed to + V",
    "uz": "… qilishi kerak edi",
    "ex": "The bus was supposed to come at 8.",
    "use": "Shikoyat"
   },
   {
    "s": "was due to + V",
    "uz": "rejalashtirilgan edi",
    "ex": "The project was due to finish in 2020.",
    "use": "Rasmiy"
   },
   {
    "s": "thought / hoped / expected + would",
    "uz": "fikr va umid",
    "ex": "I hoped I would get 7.0.",
    "use": "Speaking"
   },
   {
    "s": "Task 1: was expected to (past forecast)",
    "uz": "o'tmishdagi prognoz",
    "ex": "In 2000, sales were expected to double.",
    "use": "Task 1"
   },
   {
    "s": "❌ I knew it will be hard → ✅ I knew it would be hard",
    "uz": "o'tmish fikrida will → would",
    "ex": "I thought it would rain.",
    "use": "Tipik xato"
   }
  ]
 },
