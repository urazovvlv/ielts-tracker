{
 "grammar": {
  "theme": "Punctuation for IELTS Writing",
  "items": [
   {
    "s": "Full stop between complete sentences",
    "uz": "ikki to'liq gapni vergul bilan ulamang",
    "ex": "Prices rose. Sales fell.",
    "use": "Run-on xatosiga qarshi"
   },
   {
    "s": "Comma after linking words at the start",
    "uz": "However, Therefore, In addition,",
    "ex": "However, this is not always true.",
    "use": "Kohezion"
   },
   {
    "s": "Semicolon before however",
    "uz": "; however, — ikki gapni bog'laydi",
    "ex": "Cars are useful; however, they pollute.",
    "use": "Band 7 GRA"
   },
   {
    "s": "Commas around non-defining clauses",
    "uz": "qo'shimcha ma'lumot vergul ichida",
    "ex": "Tashkent, which has 3 million people, is growing.",
    "use": "Relative clauses"
   },
   {
    "s": "Apostrophe: possession",
    "uz": "people's, children's, the country's",
    "ex": "Children's health is important.",
    "use": "Tipik xato joyi"
   },
   {
    "s": "it's vs its",
    "uz": "it's = it is; its = uning",
    "ex": "The company lost its biggest client.",
    "use": "Tipik xato"
   },
   {
    "s": "No contractions in Writing",
    "uz": "don't → do not",
    "ex": "This does not mean that…",
    "use": "Rasmiy uslub"
   },
   {
    "s": "Commas in lists",
    "uz": "A, B and C",
    "ex": "Coal, gas and oil are fossil fuels.",
    "use": "Ro'yxatlar"
   }
  ]
 },
