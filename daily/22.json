{
 "grammar": {
  "theme": "Cause and effect linkers",
  "items": [
   {
    "s": "because + gap / because of + ot",
    "uz": "sabab",
    "ex": "Many people drive because buses are slow. / because of slow buses",
    "use": "Asosiy farq"
   },
   {
    "s": "due to / owing to + ot",
    "uz": "rasmiy sabab",
    "ex": "Flights were cancelled due to fog.",
    "use": "Task 1/2"
   },
   {
    "s": "as / since + gap (boshida)",
    "uz": "sababni gap boshida berish",
    "ex": "Since prices rose, sales fell.",
    "use": "Xilma-xillik"
   },
   {
    "s": "therefore / consequently / as a result",
    "uz": "natija — yangi gap boshida",
    "ex": "Prices rose. As a result, sales fell.",
    "use": "Task 2 kohezion"
   },
   {
    "s": "so + natija",
    "uz": "norasmiyroq natija",
    "ex": "It was late, so we went home.",
    "use": "Speaking"
   },
   {
    "s": "lead to / result in / cause",
    "uz": "fe'llar bilan sabab-natija",
    "ex": "Pollution causes breathing problems.",
    "use": "Band 7 xilma-xillik"
   },
   {
    "s": "result from / stem from",
    "uz": "natija sababdan kelib chiqadi",
    "ex": "Many problems stem from poverty.",
    "use": "Task 2"
   },
   {
    "s": "❌ Due to people drive → ✅ Because people drive / Due to heavy traffic",
    "uz": "due to dan keyin gap emas, ot",
    "ex": "Due to heavy traffic, I was late.",
    "use": "Tipik xato"
   }
  ]
 },
