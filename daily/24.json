    "use": "Ravon uslub"
   },
   {
    "s": "Comma after a fronted clause",
    "uz": "ergash gap boshida bo'lsa vergul",
    "ex": "When the price fell, sales rose.",
    "use": "Tinish belgisi"
   },
   {
    "s": "No comma before because (usually)",
