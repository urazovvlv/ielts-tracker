    "use": "Tinish belgisi"
   },
   {
    "s": "❌ Because it is cheap. (fragment) → ✅ Many people buy it because it is cheap.",
    "uz": "because qismi yolg'iz gap bo'lolmaydi",
    "ex": "Many choose buses because they are cheap.",
    "use": "Tipik xato"
   }
  ]
