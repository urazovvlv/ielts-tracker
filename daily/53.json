{
 "grammar": {
  "theme": "Common errors of Uzbek speakers (2): verbs and word order",
  "items": [
   {
    "s": "Third person -s",
    "uz": "u/u (narsa) — fe'lga -s",
    "ex": "❌ She work → ✅ She works",
    "use": "Speaking va Writing"
   },
   {
    "s": "Word order: subject + verb + object",
    "uz": "ingliz tilida fe'l egadan keyin",
    "ex": "❌ Very much I like it → ✅ I like it very much",
    "use": "Asosiy tartib"
   },
   {
    "s": "Adverb placement: not between verb and object",
    "uz": "fe'l va to'ldiruvchi orasiga ravish qo'ymang",
    "ex": "❌ I speak well English → ✅ I speak English well",
    "use": "Tipik xato"
   },
   {
    "s": "Present Perfect overused or missed",
    "uz": "aniq vaqt — Past Simple",
    "ex": "❌ I have been there in 2019 → ✅ I went there in 2019",
    "use": "Takrorlash"
   },
   {
    "s": "make vs do confusion",
    "uz": "do a mistake ❌",
    "ex": "✅ make a mistake, do homework",
    "use": "Kollokatsiya"
   },
   {
    "s": "explain me ❌ → explain to me",
    "uz": "explain + to + kishi",
    "ex": "Could you explain it to me?",
    "use": "Tipik xato"
   },
   {
    "s": "I am agree ❌ → I agree",
    "uz": "agree — fe'l, am kerak emas",
    "ex": "I agree with you.",
    "use": "Juda keng tarqalgan"
   },
   {
    "s": "It depends from ❌ → depends on",
    "uz": "predlog xatosi",
    "ex": "It depends on the weather.",
    "use": "Speaking"
   }
  ]
 },
