{
 "grammar": {
  "theme": "Used to, would and be/get used to",
  "items": [
   {
    "s": "used to + V",
    "uz": "o'tmishdagi odat yoki holat (endi yo'q)",
    "ex": "I used to live in a village.",
    "use": "Part 1: bolalik"
   },
   {
    "s": "would + V (past habit)",
    "uz": "o'tmishdagi takroriy harakat (holat emas)",
    "ex": "My grandmother would tell us stories every night.",
    "use": "Band 7 hikoya"
   },
   {
    "s": "didn't use to + V",
    "uz": "inkor shakli: use (d yo'q)",
    "ex": "I didn't use to like vegetables.",
    "use": "Tipik yozuv xatosi"
   },
   {
    "s": "Did you use to …?",
    "uz": "so'roq shakli",
    "ex": "Did you use to play outside?",
    "use": "Part 1 savollari"
   },
   {
    "s": "be used to + -ing / noun",
    "uz": "... ga ko'nikkan bo'lmoq",
    "ex": "I'm used to waking up early.",
    "use": "Hozirgi odat"
   },
   {
    "s": "get used to + -ing",
    "uz": "... ga ko'nikmoq (jarayon)",
    "ex": "It took me a year to get used to city life.",
    "use": "O'zgarishlar haqida"
   },
   {
    "s": "❌ I'm used to live alone → ✅ I'm used to living alone",
    "uz": "be used to dan keyin -ing",
    "ex": "I'm used to living alone now.",
    "use": "Tipik xato"
   },
   {
    "s": "❌ I would live in Samarkand → ✅ I used to live",
    "uz": "holat (live, have, be) uchun would emas",
    "ex": "I used to have long hair.",
    "use": "Tipik xato"
   }
  ]
 },
