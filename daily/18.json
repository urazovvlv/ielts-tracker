{
 "grammar": {
  "theme": "Question forms and indirect questions",
  "items": [
   {
    "s": "Auxiliary + subject + verb",
    "uz": "so'roq gapda yordamchi fe'l egadan oldin",
    "ex": "Do you enjoy your job? Where did you go?",
