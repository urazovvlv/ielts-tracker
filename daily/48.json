{
 "grammar": {
  "theme": "Tense consistency in Task 1",
  "items": [
   {
    "s": "Past data → Past Simple",
    "uz": "o'tgan yillar — o'tgan zamon",
    "ex": "In 2010, sales rose to 500.",
    "use": "Asosiy qoida"
   },
   {
    "s": "No dates → Present Simple",
    "uz": "vaqtsiz diagramma — hozirgi zamon",
    "ex": "The process consists of six stages.",
    "use": "Process/table"
   },
   {
    "s": "Future data → future forms",
    "uz": "prognoz — kelasi zamon shakllari",
    "ex": "Sales are expected to reach 900.",
    "use": "Prognoz"
   },
   {
    "s": "Past + future in one chart",
    "uz": "ikkalasini to'g'ri bog'lang",
    "ex": "Sales grew until 2020 and are projected to fall.",
    "use": "Aralash"
   },
   {
    "s": "Past Perfect for 'by + past year'",
    "uz": "o'tmish nuqtasigacha",
    "ex": "By 2000, the figure had doubled.",
    "use": "Band 7"
   },
   {
    "s": "Introduction in Present Simple",
    "uz": "The graph shows …",
    "ex": "The graph shows changes in …",
    "use": "Kirish"
   },
   {
    "s": "Maps: past passive / present perfect passive",
    "uz": "was built / has been replaced",
    "ex": "A school was built in 2005.",
    "use": "Maps"
   },
   {
    "s": "❌ In 1990, the number increases → ✅ increased",
    "uz": "o'tgan yil + o'tgan zamon",
    "ex": "In 1990, the number increased.",
    "use": "Tipik xato"
   }
  ]
 },
