{
 "grammar": {
  "theme": "Reported speech",
  "items": [
   {
    "s": "said (that) + backshift",
    "uz": "zamon bir pog'ona orqaga: is → was",
    "ex": "He said that he was tired.",
    "use": "Hikoya qilish"
   },
   {
    "s": "told + person + (that)",
    "uz": "told dan keyin kimga aytilgani",
    "ex": "She told me that she had passed.",
    "use": "said vs told"
   },
   {
    "s": "will → would, can → could",
    "uz": "modal o'zgarishi",
    "ex": "He said he would call later.",
    "use": "Speaking hikoya"
   },
   {
    "s": "asked + if/whether",
    "uz": "ha/yo'q savollarni aytib berish",
    "ex": "She asked if I was ready.",
    "use": "Savolni aytib berish"
   },
   {
    "s": "asked + wh- + statement order",
    "uz": "so'roq tartibi o'zgaradi",
    "ex": "He asked where I lived.",
    "use": "Tipik xato joyi"
   },
   {
    "s": "told/asked + someone + to V",
    "uz": "buyruq va iltimos",
    "ex": "The teacher told us to be quiet.",
    "use": "Buyruqlar"
   },
   {
    "s": "Reporting verbs: suggest, admit, deny",
    "uz": "ko'proq akademik fe'llar",
    "ex": "Experts suggest that sleep improves memory.",
    "use": "Task 2: research shows…"
   },
   {
    "s": "❌ He said me → ✅ He told me / He said to me",
    "uz": "said dan keyin kishi to'g'ridan kelmaydi",
    "ex": "He told me the news.",
    "use": "Tipik xato"
   }
  ]
 },
