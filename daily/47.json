{
 "grammar": {
  "theme": "Agreement with quantity phrases (Task 1)",
  "items": [
   {
    "s": "The majority of + plural noun + plural verb",
    "uz": "ko'pchilik + ko'plik fe'l",
    "ex": "The majority of students were female.",
    "use": "Task 1"
   },
   {
    "s": "The majority of + uncountable + singular verb",
    "uz": "sanalmaydigan bilan birlik",
    "ex": "The majority of the money was spent on food.",
    "use": "Task 1"
   },
   {
    "s": "Half of + plural + are / Half of + singular + is",
    "uz": "otga moslashadi",
    "ex": "Half of the respondents were under 30.",
    "use": "Task 1"
   },
   {
    "s": "Each of + plural + singular verb",
    "uz": "har biri — birlik",
    "ex": "Each of the countries has its own system.",
    "use": "Grammatika"
   },
   {
    "s": "Neither of + plural + singular verb (formal)",
    "uz": "ikkalasidan hech biri",
    "ex": "Neither of the figures was accurate.",
    "use": "Rasmiy"
   },
   {
    "s": "A third of the population is …",
    "uz": "population — birlik",
    "ex": "A third of the population is over 60.",
    "use": "Task 1"
   },
   {
    "s": "Most + plural noun (no 'the')",
    "uz": "umumiy ko'pchilik",
    "ex": "Most people own a phone.",
    "use": "❌ The most people"
   },
   {
    "s": "❌ The number of students were → ✅ was",
    "uz": "number egasi birlik",
    "ex": "The number of visitors was 2 million.",
    "use": "Tipik xato (takror)"
   }
  ]
 },
