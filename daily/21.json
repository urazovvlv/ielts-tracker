{
 "grammar": {
  "theme": "Dependent prepositions",
  "items": [
   {
    "s": "interested in / good at / afraid of",
    "uz": "sifat + predlog birikmalari",
    "ex": "I'm interested in economics.",
    "use": "Speaking Part 1"
   },
   {
    "s": "depend on / rely on / focus on",
    "uz": "fe'l + on",
    "ex": "Success depends on hard work.",
    "use": "Task 2"
   },
   {
    "s": "result in / lead to",
    "uz": "natijaga olib kelmoq",
    "ex": "Stress can lead to illness.",
    "use": "Cause–effect"
   },
   {
    "s": "responsible for / famous for",
    "uz": "sifat + for",
    "ex": "Parents are responsible for their children.",
    "use": "Task 2"
   },
   {
    "s": "an increase in / a rise in",
    "uz": "o'zgarish otlari + in",
    "ex": "There was an increase in sales.",
    "use": "Task 1"
   },
   {
    "s": "a reason for / a solution to",
    "uz": "ot + predlog",
    "ex": "One solution to traffic is better buses.",
    "use": "Task 2 yechim"
   },
   {
    "s": "the impact on / the effect on",
    "uz": "ta'sir + on",
    "ex": "Technology has a big effect on children.",
    "use": "Task 2"
   },
   {
    "s": "❌ discuss about / emphasise on → ✅ discuss / emphasise",
    "uz": "bu fe'llardan keyin predlog kerak emas",
    "ex": "This essay will discuss both views.",
    "use": "Tipik xato"
   }
  ]
 },
