 "task1": {
  "theme": "Sentence patterns for data",
  "items": [
   {
    "w": "There was a + adj + noun + in",
    "syn": "—",
    "uz": "Shablon: There was a sharp rise in …",
    "ex": "There was a steady decline in coal use."
   },
   {
    "w": "X + verb + adverb",
    "syn": "—",
    "uz": "Shablon: Coal use declined steadily.",
    "ex": "The number of cars increased sharply."
   },
   {
    "w": "X saw/witnessed a …",
    "syn": "experienced",
    "uz": "X da … kuzatildi",
    "ex": "2008 saw a dramatic fall in house prices."
   },
   {
    "w": "…, which was followed by …",
    "syn": "after which",
    "uz": "…, undan keyin esa …",
    "ex": "Sales rose to 500, which was followed by a slight dip."
   },
   {
    "w": "…, before + -ing",
    "syn": "and then",
    "uz": "… va keyin …",
    "ex": "It peaked at 80% before falling to 60%."
   },
   {
    "w": "…, reaching …",
    "syn": "and reached",
    "uz": "… ga yetib",
    "ex": "Exports doubled, reaching $4 billion in 2010."
   },
   {
    "w": "…, with X + -ing",
    "syn": "while",
    "uz": "… va bunda X …",
    "ex": "Most people used cars, with only 10% taking buses."
   },
   {
    "w": "Similarly, …",
    "syn": "Likewise",
    "uz": "Xuddi shunday, …",
    "ex": "Similarly, spending on clothes rose."
   },
   {
    "w": "As for …,",
    "syn": "Regarding …,",
    "uz": "…ga kelsak,",
    "ex": "As for Germany, the figure remained stable."
   },
   {
    "w": "In comparison,",
    "syn": "By comparison",
    "uz": "Taqqoslaganda,",
    "ex": "In comparison, only 5% used trains."
   }
  ]
 },
