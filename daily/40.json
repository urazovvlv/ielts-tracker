{
 "grammar": {
  "theme": "Referencing: this, these, such, the former / the latter",
  "items": [
   {
    "s": "this + noun",
    "uz": "oldingi fikrga ishora (ot bilan aniqroq)",
    "ex": "Prices rose sharply. This increase hurt families.",
    "use": "Coherence band 7"
   },
   {
    "s": "these + plural noun",
    "uz": "ko'plikdagi ishora",
    "ex": "Cars and planes pollute. These forms of transport…",
    "use": "Takrordan qochish"
   },
   {
    "s": "such + noun",
    "uz": "bunday",
    "ex": "Such policies are expensive.",
    "use": "Akademik"
   },
   {
    "s": "the former / the latter",
    "uz": "birinchisi / ikkinchisi",
    "ex": "Buses and trains are cheap; the latter are faster.",
    "use": "Band 7+"
   },
   {
    "s": "it / they",
    "uz": "aniq ot bilan bog'langan bo'lsin",
    "ex": "The government introduced a tax. It reduced smoking.",
    "use": "Aniqlik"
   },
   {
    "s": "doing so",
    "uz": "buni qilish",
    "ex": "Recycling is easy, and doing so saves money.",
    "use": "Takrordan qochish"
   },
   {
    "s": "this trend / this problem / this approach",
    "uz": "this + umumlashtiruvchi ot",
    "ex": "This approach has two advantages.",
    "use": "Task 2"
   },
   {
    "s": "❌ This is a problem. This is because this … → ✅ vary references",
    "uz": "bir xil ishorani takrorlamang",
    "ex": "This issue arises because…",
    "use": "Haddan ortiq 'this'"
   }
  ]
 },
