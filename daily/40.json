 "speaking": {
  "theme": "Using idioms naturally in Speaking",
  "items": [
   {
    "s": "Use 1–2 idioms per part, not more",
    "uz": "me'yorida",
    "ex": "Har javobga idioma tiqmang",
    "use": "Tabiiylik"
   },
   {
    "s": "Make sure the idiom fits the topic",
    "uz": "mos kontekst",
    "ex": "It's raining cats and dogs ❌ (eskirgan)",
    "use": "Eskirgan idiomalardan qoching"
   },
   {
    "s": "Use idioms in informal parts",
    "uz": "Part 1–2",
    "ex": "Part 1–2 da tabiiyroq",
    "use": "Register"
   },
   {
    "s": "Get the form exactly right",
    "uz": "aniq shakl",
    "ex": "❌ a piece of a cake → ✅ a piece of cake",
    "use": "Aniqlik"
   },
   {
    "s": "Collocations matter more than idioms",
    "uz": "kollokatsiyalar muhimroq",
    "ex": "make a decision > idioms",
    "use": "LR band 7"
   },
   {
    "s": "Phrasal verbs count as idiomatic language",
