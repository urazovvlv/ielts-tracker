    "ex": "I grew up in Samarkand.",
    "use": "LR"
   },
   {
    "s": "I was over the moon (natural)",
    "uz": "tabiiy misol",
    "ex": "When I passed, I was over the moon.",
    "use": "Part 2"
   },
   {
    "s": "It cost an arm and a leg (natural)",
    "uz": "tabiiy misol",
    "ex": "The flight cost an arm and a leg.",
    "use": "Part 1"
   },
   {
    "s": "Avoid clichés like 'every coin has two sides'",
    "uz": "klishe",
    "ex": "Klishelar band ko'tarmaydi",
    "use": "Original bo'ling"
   },
   {
    "s": "Learn idioms in sentences",
    "uz": "gap ichida",
    "ex": "Daily'dagi misol gaplarni yodlang",
    "use": "Mashq usuli"
   }
  ]
 },
