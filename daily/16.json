{
 "grammar": {
  "theme": "Narrative tenses: Past Continuous and Past Perfect",
  "items": [
   {
    "s": "was/were + -ing",
    "uz": "o'tmishda ma'lum vaqtda davom etayotgan ish",
    "ex": "I was studying when you called.",
    "use": "Part 2 hikoya fon"
   },
   {
    "s": "Past Continuous + when + Past Simple",
    "uz": "uzoq ish + to'satdan sodir bo'lgan ish",
    "ex": "We were walking home when it started to rain.",
    "use": "Hikoyani jonlantirish"
   },
   {
    "s": "while + Past Continuous",
    "uz": "bir vaqtda ikki ish",
    "ex": "While I was waiting, I read a book.",
    "use": "Part 2"
   },
   {
    "s": "had + V3 (Past Perfect)",
    "uz": "o'tmishdagi boshqa voqeadan oldin bo'lgan ish",
    "ex": "When I arrived, the train had already left.",
    "use": "Band 7 hikoya"
   },
   {
    "s": "by the time + Past Simple, Past Perfect",
    "uz": "... bo'lguncha, allaqachon ...",
    "ex": "By the time I graduated, I had learned three languages.",
    "use": "Murakkab gap"
   },
   {
    "s": "had never + V3 + before",
    "uz": "o'shangacha hech qachon ...",
    "ex": "I had never seen the sea before that trip.",
    "use": "Birinchi tajriba hikoyasi"
   },
   {
    "s": "Task 1: had + V3 by 2000",
    "uz": "o'tmish nuqtasigacha bo'lgan o'zgarish",
    "ex": "By 2000, the population had doubled.",
    "use": "Task 1 o'tgan davr"
   },
   {
    "s": "❌ When I came, he already left → ✅ he had already left",
    "uz": "oldin bo'lgan ish uchun Past Perfect",
    "ex": "When I came home, everyone had gone to bed.",
    "use": "Tipik xato"
   }
  ]
 },
