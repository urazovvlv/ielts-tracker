{
 "grammar": {
  "theme": "Common errors of Uzbek speakers (1): nouns and articles",
  "items": [
   {
    "s": "Missing a/an before singular nouns",
    "uz": "o'zbek tilida artikl yo'q — shuning uchun tushib qoladi",
    "ex": "❌ I have car → ✅ I have a car",
    "use": "Har birlik otni tekshiring"
   },
   {
    "s": "Plural after numbers and 'many'",
    "uz": "son va many dan keyin ko'plik -s",
    "ex": "❌ many student → ✅ many students",
    "use": "Writing"
   },
   {
    "s": "No plural after 'people'",
    "uz": "people allaqachon ko'plik",
    "ex": "❌ peoples are → ✅ people are",
    "use": "Tipik xato"
   },
   {
    "s": "informations / advices / furnitures",
    "uz": "sanalmaydigan otlarga -s yo'q",
    "ex": "✅ information, advice, furniture",
    "use": "Takrorlash"
   },
   {
    "s": "one of the + plural",
    "uz": "biri — ko'plik ot bilan",
    "ex": "❌ one of the reason → ✅ one of the reasons",
    "use": "Task 2"
   },
   {
    "s": "every / each + singular",
    "uz": "har bir — birlik",
    "ex": "❌ every students → ✅ every student",
    "use": "Grammatika"
   },
   {
    "s": "the + superlative always",
    "uz": "eng … — the bilan",
    "ex": "❌ most important thing → ✅ the most important thing",
    "use": "Speaking"
   },
   {
    "s": "Possessive 's for people",
    "uz": "egalik",
    "ex": "❌ the car of my father → ✅ my father's car",
    "use": "Tabiiylik"
   }
  ]
 },
